---
interface Props {
  /**
   * Extensionless path to the optimised asset, e.g. `/shots/tenant-ops-tenants`.
   * The plate renders WebP with a JPEG fallback through <picture>.
   */
  src: string;
  /** Plate number, e.g. "FIG. 4.2" */
  plate: string;
  caption: string;
  /** Optional measurement note in the plate's lower-right corner. */
  measure?: string;
  alt: string;
  /** CSS aspect-ratio, so the plate never shifts the page as it loads. */
  aspect?: string;
  priority?: boolean;
}

const { src, plate, caption, measure, alt, aspect = '16 / 10', priority = false } = Astro.props;
---

<figure class="group plate" data-plate>
  <button
    type="button"
    class="plate-trigger block w-full cursor-zoom-in overflow-hidden border border-rule bg-paper-raised text-left shadow-plate transition-[box-shadow,border-color] duration-200 hover:border-rule-strong focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brass-600"
    style={`aspect-ratio: ${aspect}`}
    data-plate-trigger
    data-full={`${src}.jpg`}
    data-full-webp={`${src}.webp`}
    data-plate={plate}
    data-caption={caption}
    data-alt={alt}
    aria-label={`Enlarge ${plate}: ${caption}`}
  >
    <picture>
      <source srcset={`${src}.webp`} type="image/webp" />
      <img
        src={`${src}.jpg`}
        alt={alt}
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="plate-img block h-full w-full object-cover"
      />
    </picture>

    <!-- Affordance. Present in the DOM, revealed on hover/focus so it is
         discoverable without becoming a permanent overlay on every plate. -->
    <span
      class="plate-hint label pointer-events-none absolute bottom-2 right-2 bg-ledger-900/95 px-2 py-1 text-bone opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-within:opacity-100"
      aria-hidden="true"
    >
      Click to enlarge
    </span>
  </button>

  <figcaption class="mt-2.5 flex items-baseline justify-between gap-4">
    <span class="flex items-baseline gap-2.5">
      <span class="label text-brass-600 tnum">{plate}</span>
      <span class="text-sm text-ink-700">{caption}</span>
    </span>
    {measure && <span class="label hidden shrink-0 text-ink-300 tnum sm:inline">{measure}</span>}
  </figcaption>
</figure>

<style>
  /* ---- the plate comes toward you -------------------------------------
     A perspective on the frame plus translateZ on the image is what makes the
     plate read as an object lifting off the page rather than a picture growing
     inside a box. The tilt follows the pointer so the lift has a direction,
     and the shadow opens up underneath at the same time. Everything is driven
     by two custom properties the script sets once per pointer move. */
  .plate-trigger {
    position: relative;
    perspective: 1400px;
    perspective-origin: var(--px, 50%) var(--py, 50%);
  }

  .plate-trigger > picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .plate-img {
    transform-origin: var(--px, 50%) var(--py, 50%);
    transform:
      rotateX(var(--rx, 0deg))
      rotateY(var(--ry, 0deg))
      translateZ(var(--tz, 0px))
      scale(var(--sc, 1));
    transition:
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 420ms cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
    backface-visibility: hidden;
  }

  /* The lift. Small on purpose: the plate must stay a document, not a toy. */
  .plate-trigger:hover .plate-img,
  .plate-trigger:focus-visible .plate-img {
    --tz: 44px;
    --sc: 1.035;
    filter: saturate(1.06) contrast(1.02);
  }

  /* Depth: the shadow opens up as the plate rises, and the frame's edge
     tightens so the object reads as closer. */
  .plate-trigger {
    transition: box-shadow 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .plate-trigger:hover,
  .plate-trigger:focus-visible {
    box-shadow:
      0 2px 0 rgba(21, 24, 26, 0.06),
      0 26px 48px -22px rgba(13, 51, 45, 0.5),
      0 44px 80px -40px rgba(13, 51, 45, 0.4);
  }

  .dark .plate-trigger:hover,
  .dark .plate-trigger:focus-visible {
    box-shadow:
      0 2px 0 rgba(0, 0, 0, 0.4),
      0 26px 48px -22px rgba(0, 0, 0, 0.8),
      0 44px 80px -40px rgba(0, 0, 0, 0.9);
  }

  /* A plate that is being dragged inside the viewer is not a hover target. */
  @media (prefers-reduced-motion: reduce) {
    .plate-img {
      transition: none;
      transform: none;
    }
    .plate-trigger:hover .plate-img,
    .plate-trigger:focus-visible .plate-img {
      /* No motion, but still the emphasis: a flat, honest brightening. */
      filter: saturate(1.08) contrast(1.04);
    }
    .plate-trigger,
    .plate-trigger:hover,
    .plate-trigger:focus-visible {
      transition: none;
    }
  }
</style>

---
/**
 * PlateLightbox — one immersive viewer for every plate on the page.
 *
 * A native <dialog> with showModal(), which brings us the focus trap, the
 * backdrop, Escape-to-close and the top layer for free. What we add on top:
 * pan, zoom, prev/next between plates, and focus returned to the plate that
 * opened it.
 *
 * Rendered once per page; every plate trigger in FigurePlate opens this.
 */
---

<dialog
  id="plate-lightbox"
  class="m-0 h-screen max-h-none w-screen max-w-none bg-transparent p-0"
  aria-labelledby="plate-lightbox-caption"
>
  <!-- Backdrop. A solid surface, not a blur: blur as decoration is the tell.
       A sibling of the content so clicks on it are actually reachable. -->
  <div class="absolute inset-0 bg-ledger-900" data-plate-backdrop aria-hidden="true"></div>

  <div class="relative flex h-full w-full flex-col">
    <!-- Chrome -->
    <header class="flex items-center justify-between gap-4 border-b border-rule-bone px-4 py-3 sm:px-6">
      <p class="label text-brass-400" data-plate-plate>FIG. —</p>
      <div class="flex items-center gap-1.5">
        <button
          type="button"
          class="label border border-rule-bone px-2.5 py-1.5 text-bone transition-colors hover:border-bone"
          data-plate-zoom-out
          aria-label="Zoom out"
        >
          &minus;
        </button>
        <span class="label w-14 text-center text-bone/70 tnum" data-plate-zoom-label>100%</span>
        <button
          type="button"
          class="label border border-rule-bone px-2.5 py-1.5 text-bone transition-colors hover:border-bone"
          data-plate-zoom-in
          aria-label="Zoom in"
        >
          +
        </button>
        <button
          type="button"
          class="label border border-rule-bone px-2.5 py-1.5 text-bone transition-colors hover:border-bone"
          data-plate-reset
        >
          Fit
        </button>
        <a
          class="label border border-rule-bone px-2.5 py-1.5 text-bone no-underline transition-colors hover:border-bone"
          data-plate-open
          href="#"
          target="_blank"
          rel="noopener"
        >
          Full size ↗
        </a>
        <button
          type="button"
          class="label ml-1 border border-rule-bone px-2.5 py-1.5 text-bone transition-colors hover:border-bone"
          data-plate-close
          aria-label="Close viewer"
        >
          Close ✕
        </button>
      </div>
    </header>

    <!-- Stage -->
    <div
      class="relative flex flex-1 cursor-grab items-center justify-center overflow-hidden active:cursor-grabbing"
      data-plate-stage
    >
      <img
        class="block max-h-full max-w-full select-none object-contain"
        data-plate-image
        alt=""
        draggable="false"
      />
    </div>

    <!-- Caption + pagination -->
    <footer class="border-t border-rule-bone px-4 py-3 sm:px-6">
      <p class="text-sm text-bone/80" id="plate-lightbox-caption" data-plate-caption></p>
      <div class="mt-2 flex items-center justify-between gap-4">
        <p class="label text-bone/50" data-plate-counter></p>
        <div class="flex items-center gap-1.5">
          <button
            type="button"
            class="label border border-rule-bone px-2.5 py-1.5 text-bone transition-colors hover:border-bone"
            data-plate-prev
          >
            ← Previous
          </button>
          <button
            type="button"
            class="label border border-rule-bone px-2.5 py-1.5 text-bone transition-colors hover:border-bone"
            data-plate-next
          >
            Next →
          </button>
        </div>
      </div>
      <p class="label mt-3 text-bone/40">
        Drag to pan · scroll or +/− to zoom · 0 to fit · ← → to move · Esc to close
      </p>
    </footer>
  </div>
</dialog>

<style>
  /* Deterministic, not delegated to Tailwind's `open:` variant — a stray
     `hidden` utility was beating it and the dialog never appeared. */
  #plate-lightbox {
    display: none;
    position: fixed;
    inset: 0;
  }
  #plate-lightbox[open] {
    display: block;
  }
  #plate-lightbox::backdrop {
    background: transparent;
  }
</style>

<script>
  const dialog = document.getElementById('plate-lightbox') as HTMLDialogElement | null;
  if (dialog) {
    const image = dialog.querySelector<HTMLImageElement>('[data-plate-image]')!;
    const stage = dialog.querySelector<HTMLElement>('[data-plate-stage]')!;
    const backdrop = dialog.querySelector<HTMLElement>('[data-plate-backdrop]')!;
    const plateLabel = dialog.querySelector<HTMLElement>('[data-plate-plate]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-plate-caption]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-plate-counter]')!;
    const zoomLabel = dialog.querySelector<HTMLElement>('[data-plate-zoom-label]')!;
    const openLink = dialog.querySelector<HTMLAnchorElement>('[data-plate-open]')!;

    type Plate = {
      trigger: HTMLButtonElement;
      full: string;
      webp: string;
      plate: string;
      caption: string;
      alt: string;
    };

    const plates: Plate[] = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-plate-trigger]'),
    ).map((trigger) => ({
      trigger,
      full: trigger.dataset.full ?? '',
      webp: trigger.dataset.fullWebp ?? '',
      plate: trigger.dataset.plate ?? '',
      caption: trigger.dataset.caption ?? '',
      alt: trigger.dataset.alt ?? '',
    }));

    let index = 0;
    let scale = 1;
    let tx = 0;
    let ty = 0;
    let opener: HTMLElement | null = null;

    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

    function apply() {
      image.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
      zoomLabel.textContent = `${Math.round(scale * 100)}%`;
    }

    function reset() {
      scale = 1;
      tx = 0;
      ty = 0;
      apply();
    }

    function zoomTo(next: number, focalX = 0, focalY = 0) {
      const prev = scale;
      const clamped = clamp(next, 1, 6);
      if (clamped === prev) return;
      // Keep the point under the cursor stationary while zooming.
      const k = clamped / prev;
      tx = focalX - k * (focalX - tx);
      ty = focalY - k * (focalY - ty);
      scale = clamped;
      apply();
    }

    function show(i: number) {
      index = (i + plates.length) % plates.length;
      const p = plates[index];
      if (!p) return;
      // WebP when it is available, JPEG otherwise.
      image.src = p.webp || p.full;
      image.alt = p.alt;
      plateLabel.textContent = p.plate;
      caption.textContent = p.caption;
      counter.textContent = plates.length > 1
        ? `${index + 1} of ${plates.length} plates on this page`
        : 'the only plate on this page';
      openLink.href = p.full;
      const prev = dialog.querySelector<HTMLButtonElement>('[data-plate-prev]')!;
      const next = dialog.querySelector<HTMLButtonElement>('[data-plate-next]')!;
      prev.disabled = plates.length < 2;
      next.disabled = plates.length < 2;
      reset();
    }

    // ---- open ----
    document.querySelectorAll<HTMLButtonElement>('[data-plate-trigger]').forEach((trigger) => {
      // Hover magnification follows the pointer so a dense screenshot can be
      // read in place. Set the origin, then let the CSS transition run.
      trigger.addEventListener('pointermove', (e) => {
        const r = trigger.getBoundingClientRect();
        trigger.style.setProperty('--px', `${((e.clientX - r.left) / r.width) * 100}%`);
        trigger.style.setProperty('--py', `${((e.clientY - r.top) / r.height) * 100}%`);
      });
      trigger.addEventListener('pointerleave', () => {
        trigger.style.removeProperty('--px');
        trigger.style.removeProperty('--py');
      });

      trigger.addEventListener('click', () => {
        const i = plates.findIndex((p) => p.trigger === trigger);
        if (i < 0) return;
        opener = trigger;
        show(i);
        if (typeof dialog.showModal === 'function') dialog.showModal();
        else dialog.setAttribute('open', '');
        (dialog.querySelector<HTMLButtonElement>('[data-plate-close]') ?? dialog).focus();
      });
    });

    // ---- close ----
    function close() {
      if (typeof dialog.close === 'function') dialog.close();
      else dialog.removeAttribute('open');
      // Focus goes back to the plate that opened it, not to the top of the page.
      opener?.focus();
    }

    dialog.querySelector('[data-plate-close]')?.addEventListener('click', close);

    // Close when the click lands on empty chrome rather than on content. Both
    // the dialog itself and the stage behind the image count.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
    stage.addEventListener('click', (e) => {
      if (e.target === stage) close();
    });

    // Clicking the image toggles between fit and a readable zoom.
    image.addEventListener('click', (e) => {
      e.stopPropagation();
      if (scale > 1) reset();
      else zoomTo(2.5);
    });

    // ---- controls ----
    dialog.querySelector('[data-plate-zoom-in]')?.addEventListener('click', () => zoomTo(scale * 1.4));
    dialog.querySelector('[data-plate-zoom-out]')?.addEventListener('click', () => zoomTo(scale / 1.4));
    dialog.querySelector('[data-plate-reset]')?.addEventListener('click', reset);
    dialog.querySelector('[data-plate-prev]')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-plate-next]')?.addEventListener('click', () => show(index + 1));

    // ---- drag to pan ----
    // Capture the pointer only once the pointer has actually moved. Capturing
    // on pointerdown retargets the follow-up `click` to the stage, which would
    // swallow every click on the image — the zoom toggle would never fire.
    let dragging = false;
    let pending = false;
    let lastX = 0;
    let lastY = 0;
    const THRESHOLD = 4;

    stage.addEventListener('pointerdown', (e) => {
      if (scale <= 1) return;
      pending = true;
      dragging = false;
      lastX = e.clientX;
      lastY = e.clientY;
    });

    stage.addEventListener('pointermove', (e) => {
      if (!pending || dragging) return;
      if (Math.abs(e.clientX - lastX) < THRESHOLD && Math.abs(e.clientY - lastY) < THRESHOLD) {
        return;
      }
      dragging = true;
      pending = false;
      try {
        stage.setPointerCapture(e.pointerId);
      } catch {
        /* capture is an optimisation; panning still works without it */
      }
    });

    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      tx += e.clientX - lastX;
      ty += e.clientY - lastY;
      lastX = e.clientX;
      lastY = e.clientY;
      apply();
    });

    const endDrag = (e: PointerEvent) => {
      pending = false;
      dragging = false;
      if (stage.hasPointerCapture(e.pointerId)) stage.releasePointerCapture(e.pointerId);
    };
    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);

    // ---- wheel to zoom, anchored on the cursor ----
    stage.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        const r = stage.getBoundingClientRect();
        zoomTo(scale * (e.deltaY < 0 ? 1.12 : 1 / 1.12), e.clientX - r.left - r.width / 2, e.clientY - r.top - r.height / 2);
      },
      { passive: false },
    );

    // ---- keyboard ----
    dialog.addEventListener('keydown', (e) => {
      const key = e.key;
      if (key === 'Escape') {
        e.preventDefault();
        close();
      } else if (key === 'ArrowLeft' && plates.length > 1) {
        show(index - 1);
      } else if (key === 'ArrowRight' && plates.length > 1) {
        show(index + 1);
      } else if (key === '+' || key === '=') {
        zoomTo(scale * 1.25);
      } else if (key === '-') {
        zoomTo(scale / 1.25);
      } else if (key === '0') {
        reset();
      }
    });

    apply();
  }
</script>

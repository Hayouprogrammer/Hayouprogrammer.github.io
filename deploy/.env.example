# Deploy configuration — copy to `.env` beside this file and fill it in.
#
#   cp .env.example .env
#
# `.env` is gitignored. It is deployment configuration, not source, and it holds
# a value that is different for every machine — putting it in the repository
# would mean every deploy wrote over it.

# The domain the site is served on. Caddy obtains and renews the certificate for
# this automatically; there is nothing to install and nothing to expire.
#
# This is also the value the printed QR codes must encode. Buy the domain in
# your own account (Cloudflare Registrar is at-cost, Porkbun is cheap and simple)
# and point DNS at this VPS before the first real deploy.
SITE_DOMAIN=localhost

# Where Let's Encrypt sends expiry warnings. Caddy renews without this — it is
# only ever a courtesy address for the day something goes wrong.
ACME_EMAIL=admin@localhost

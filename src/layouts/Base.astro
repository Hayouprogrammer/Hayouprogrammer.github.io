---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PlateLightbox from '../components/PlateLightbox.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description: string;
  /** Short serial shown in the masthead, e.g. "PL. 01". */
  plate?: string;
  /** Hide the site masthead and footer (used on the print CV). */
  bare?: boolean;
  /** Prevents a page indexing itself — for the thin redirect route. */
  noindex?: boolean;
}

const {
  title,
  description,
  plate,
  bare = false,
  noindex = false,
} = Astro.props;

// `site` is always set by astro.config.mjs (SITE_URL, defaulting to the live
// origin), so the fallback is unreachable — it exists only to satisfy the type.
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://hayouprogrammer.github.io').href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- GitHub Pages serves neither _headers nor _redirects, so the security
         headers Cloudflare gets from public/_headers are simply absent there.
         They are deliberately NOT reproduced as <meta>: a CSP delivered that
         way blocks the theme bootstrap and Astro's transition runtime, and a
         rule that breaks the page is worse than no rule. See DEPLOY.md. -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Theme resolution before first paint: no flash of the wrong sheet.
         Render-blocking and *external* rather than inline, so a strict
         script-src 'self' CSP in public/_headers can be enforced without an
         'unsafe-inline' escape hatch. `is:inline` here tells Astro to leave the
         tag exactly as written instead of bundling the referenced file. -->
    <script src="/theme-init.js" is:inline></script>
  </head>

  <body class="min-h-screen">
    <!-- One tab stop, before anything else, and it actually moves focus. -->
    <a
      href="#main"
      class="label sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ledger-900 focus:px-4 focus:py-3 focus:text-bone focus:no-underline"
      >Skip to content</a
    >

    <!-- The sheet. Everything the reader sees is written on it, which is what
         makes the light and dark schemes two materials rather than two colour
         inversions — see `.sheet` in global.css. -->
    <div class="sheet">
      {!bare && <SiteHeader plate={plate} />}
      <main id="main">
        <slot />
      </main>
      {!bare && <SiteFooter />}
    </div>

    <!-- Reading position, as a dimension line down the margin. Decorative: the
         document is navigable without it, and it is hidden from assistive tech
         so it is never announced as a stray control. -->
    {!bare && (
      <div class="reading-rail" aria-hidden="true">
        <i></i>
      </div>
    )}

    <PlateLightbox />
    <ClientRouter />
  </body>
</html>

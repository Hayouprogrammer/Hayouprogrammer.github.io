---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Shot from '../../components/Shot.astro';
import PathExplorer from '../../components/PathExplorer.astro';
import ScopeGrid from '../../components/ScopeGrid.astro';
import RevealWords from '../../components/RevealWords.astro';
import ContactBand from '../../components/ContactBand.astro';
import apps from '../../data/applications.json';

/**
 * The work page used to be four links, three of which pointed at anchors inside
 * the same case study. That is why it read as complicated: a visitor had to read
 * the flagship, infer that CS.02–04 were sections of it, and then go hunting for
 * the part that described their own business.
 *
 * The page now answers the question a buyer actually arrives with, in the order
 * they ask it:
 *   1. what is this?          — one screenshot and one sentence
 *   2. is it for me?          — pick the sentence that describes you
 *   3. what is inside it?     — the full catalog, derived from the repository
 *   4. how do I get in?       — the case study, or straight to a conversation
 */
const pkgRows = apps.packages.map((p) => [
  p.title.replace(/^Hiber /, ''),
  p.target,
  `${p.modules}`,
  p.description,
]);
---

<Base
  title="Work | Hayelom Gebrewahid"
  description="Imbirt runs the whole back office of a business — people, finance, stock, sales, projects, documents and the website — and arrives pre-built for hotels, landlords and trading companies."
  plate="PL. 02"
>
  <!-- ================= MASTHEAD ================= -->
  <section class="dossier mx-auto w-full max-w-6xl px-4 pt-14 sm:px-6 sm:pt-20">
    <div class="flex flex-wrap items-center gap-3">
      <span class="label text-brass-600">Plate 02 — Index of work</span>
      <span class="h-3 w-px bg-rule-strong" aria-hidden="true"></span>
      <span class="label text-ink-500">One platform · {apps.sellableByPolicy} applications</span>
    </div>

    <h1 class="mt-7 max-w-4xl text-[clamp(2.25rem,6vw,4rem)] leading-[0.98]">
      Every department of a business, on one platform — pre-built for your
      industry.
    </h1>

    <p class="mt-6 max-w-prose text-lg text-ink-700 text-pretty">
      Imbirt is a complete back office: people, money, stock, sales, projects,
      documents and the website. It arrives configured for hotels, landlords and
      trading companies — or ready to switch on only the parts you need. Nothing
      is sold by the seat.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="/work/imbirt"
        class="label inline-flex items-center gap-2 bg-ledger-900 px-5 py-3.5 text-bone no-underline transition-colors hover:bg-ledger-700"
      >
        Read the Imbirt case study
        <span aria-hidden="true">→</span>
      </a>
      <a
        href="/contact"
        class="label inline-flex items-center gap-2 border border-rule-strong px-5 py-3.5 text-ink-900 no-underline transition-colors hover:border-ledger-700 hover:bg-paper-raised"
      >
        Talk about your business
      </a>
    </div>
  </section>

  <!-- ================= THE PRODUCT, IN ONE FRAME ================= -->
  <section class="dossier mx-auto w-full max-w-6xl px-4 pt-16 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start lg:gap-14">
      <Shot
        file="ops-console.png"
        plate="FIG. 01"
        caption="The operations console — what is installed, for whom, and in what state."
        alt="Imbirt operations console listing tenants, their packages and their live module state"
        measure="1600 × 1000"
        priority
      />
      <div>
        <RevealWords
          tag="h2"
          class="max-w-xl text-[clamp(1.5rem,3.2vw,2.25rem)] leading-[1.14] text-ink-900"
          text="A hotel in Addis should not need four systems and a spreadsheet to know whether last night's rooms were cleaned, paid for and audited."
        />
        <p class="mt-7 max-w-prose text-ink-700">
          That is the question Imbirt was built to answer. One platform, one
          database per customer, and every department reading from the same
          records — so the night audit, the rent roll and the accounts cannot
          disagree with each other.
        </p>
        <div class="dim-rule mt-9" aria-hidden="true"></div>
        <dl class="mt-6 grid grid-cols-2 gap-x-8 gap-y-5 sm:grid-cols-3">
          {[
            ['Applications', `${apps.sellableByPolicy}`],
            ['Business areas', `${apps.domainOrder.length}`],
            ['Industry packages', `${apps.packages.length}`],
          ].map(([k, v]) => (
            <div>
              <dt class="label text-ink-500">{k}</dt>
              <dd class="mt-1 font-display text-3xl tnum">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ================= WHICH OF THESE IS YOU ================= -->
  <section class="dossier rise mx-auto w-full max-w-6xl px-4 pt-24 sm:px-6">
    <SectionHead
      serial="§ 01"
      kicker="Start here"
      title="Pick the sentence that describes you."
      lede="Everything below changes with your answer: the screen you would be working in, the applications that get switched on for you, and what the package contains."
    />

    <div class="mt-10">
      <PathExplorer />
    </div>
  </section>

  <!-- ================= WHAT IS INSIDE IT ================= -->
  <section class="dossier rise mx-auto w-full max-w-6xl px-4 pt-24 sm:px-6">
    <SectionHead
      serial="§ 02"
      kicker="The catalog"
      title="What is inside it."
      lede="Not three industries and a website. A whole back office, with two verticals deep enough to run a hotel and a rent roll."
    />

    <div class="mt-10">
      <ScopeGrid />
    </div>

    <p class="mt-8 max-w-prose text-ink-700">
      The catalog is generated from the repository, so this list is the product
      rather than a description of it. If a module is not here, it is not
      installed — and nothing on this page claims otherwise.
    </p>
  </section>

  <!-- ================= THE PACKAGES ================= -->
  <section class="dossier rise mx-auto w-full max-w-6xl px-4 pt-24 sm:px-6">
    <SectionHead
      serial="§ 03"
      kicker="Pre-built"
      title="Three ways to start."
      lede="A package is a working starting point, not a limit. Anything in the catalog can be switched on afterwards without a migration, because the applications share one data model."
    />

    <div class="mt-8 overflow-x-auto">
      <!-- The table is wider than a phone, so it needs to scroll. A scrollable
           region that is focusable must also be *named*, or a keyboard user can
           pan it and a screen reader has nothing to announce. This is the axe
           `scrollable-region-focusable` rule, and it fired on this exact block.
           tabindex keeps it reachable; the label says what it is. -->
      <div
        role="region"
        aria-label="The three Imbirt industry packages"
        tabindex="0"
        class="overflow-x-auto"
      >
        <table class="w-full min-w-[46rem] border-collapse text-left">
          <caption class="sr-only">The three Imbirt industry packages</caption>
          <thead>
            <tr class="border-b border-rule-strong">
              <th scope="col" class="label py-3 pr-4 text-ink-500">Package</th>
              <th scope="col" class="label py-3 pr-4 text-ink-500">For</th>
              <th scope="col" class="label py-3 pr-4 text-right text-ink-500">Modules</th>
              <th scope="col" class="label py-3 text-ink-500">What it does</th>
            </tr>
          </thead>
          <tbody>
            {pkgRows.map(([title, target, mods, desc]) => (
              <tr class="border-b border-rule align-top">
                <th scope="row" class="py-5 pr-4 font-display text-lg font-normal text-ink-900">{title}</th>
                <td class="py-5 pr-4 text-sm text-ink-700">{target}</td>
                <td class="py-5 pr-4 text-right font-display text-2xl tnum">{mods}</td>
                <td class="py-5 text-sm text-ink-700">{desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ================= HOW TO GET IN ================= -->
  <section class="dossier rise mx-auto w-full max-w-6xl px-4 pt-24 sm:px-6">
    <SectionHead
      serial="§ 04"
      kicker="Go deeper"
      title="Two ways in."
      lede="The case study is the long answer — how the platform is built and why. A conversation is the short one."
    />

    <div class="mt-10 grid gap-px border border-rule bg-rule sm:grid-cols-2">
      <a href="/work/imbirt" class="group bg-paper p-8 no-underline transition-colors hover:bg-paper-raised">
        <span class="label text-brass-600 tnum">CS. 01</span>
        <h3 class="mt-3 text-[1.625rem] leading-tight text-ink-900 group-hover:underline">
          The Imbirt case study
        </h3>
        <p class="mt-3 text-ink-700">
          How the platform is put together: the control plane, the isolated data
          plane, the governed AI assistant, and what it takes to provision a
          whole business in one action.
        </p>
        <span class="label mt-6 inline-block text-ink-500 transition-colors group-hover:text-brass-600">
          Read it <span aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/contact" class="group bg-paper p-8 no-underline transition-colors hover:bg-paper-raised">
        <span class="label text-brass-600 tnum">§ 05</span>
        <h3 class="mt-3 text-[1.625rem] leading-tight text-ink-900 group-hover:underline">
          Talk about your business
        </h3>
        <p class="mt-3 text-ink-700">
          Tell me what you run and what is going wrong with it. I will tell you
          plainly whether Imbirt is the right answer, and what it would cost to
          find out.
        </p>
        <span class="label mt-6 inline-block text-ink-500 transition-colors group-hover:text-brass-600">
          Get in touch <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </section>

  <ContactBand />
</Base>

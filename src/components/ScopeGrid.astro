---
/**
 * ScopeGrid — what the platform actually runs.
 *
 * This is the correction to a positioning mistake. The site used to say "Imbirt
 * runs hospitality, property and trading businesses", which is true but is a
 * description of three *packages*, not of the platform. Underneath them sits a
 * complete back office: people, finance, stock, sales, projects, documents, the
 * website, marketing. A manufacturer, a school, a clinic or a distributor is
 * looking for their own department on this page, and it was not there.
 *
 * Every name and every number is derived from the repository by
 * scripts/collect_apps.py into src/data/applications.json. What this component
 * adds is only a plain-language name in front of each derived one — see
 * src/data/glossary.ts for why that is allowed and where the line is. The module
 * name is always rendered alongside, so any claim here can be checked against
 * the repository without trusting this page.
 */
import { APP_GLOSS, DOMAIN_GLOSS, PLATFORM_INCLUSIONS } from '../data/glossary';
import apps from '../data/applications.json';

interface Props {
  /** Show the domain grid in full, or only the headline counts. */
  compact?: boolean;
  /** Show the platform inclusions block under the grid. */
  inclusions?: boolean;
}

const { compact = false, inclusions = true } = Astro.props;

const gloss = (name: string) => APP_GLOSS[name] ?? name;
const domainName = (name: string) => DOMAIN_GLOSS[name] ?? name;

const groups = apps.groups.map((g) => ({
  name: domainName(g.domain),
  raw: g.domain,
  renamed: g.domain !== domainName(g.domain),
  apps: g.applications.map((a) => ({
    name: a.name,
    module: a.module,
    label: gloss(a.name),
    renamed: APP_GLOSS[a.name] !== undefined && APP_GLOSS[a.name] !== a.name,
  })),
}));

const totalApps = apps.sellableByPolicy;
const totalDomains = groups.length;
---

<div class="scope">
  <div class="flex flex-wrap items-end gap-x-12 gap-y-5 border-b border-rule-strong pb-5">
    <div>
      <span class="label text-ink-500">Applications in the catalog</span>
      <p class="mt-1 font-display text-[2.75rem] leading-none tnum">{totalApps}</p>
    </div>
    <div>
      <span class="label text-ink-500">Areas of the business</span>
      <p class="mt-1 font-display text-[2.75rem] leading-none tnum">{totalDomains}</p>
    </div>
    <div>
      <span class="label text-ink-500">Pre-built industry packages</span>
      <p class="mt-1 font-display text-[2.75rem] leading-none tnum">{apps.packages.length}</p>
    </div>
    <p class="ml-auto max-w-sm text-sm text-ink-500">
      Generated from the repository. If an application is not in this list, it is
      not in the product — and nothing on this page claims otherwise.
    </p>
  </div>

  {!compact && (
    <dl class="mt-px grid gap-px bg-rule sm:grid-cols-2 lg:grid-cols-3">
      {groups.map((g) => (
        <div class="rise-block bg-paper p-6">
          <dt class="flex items-baseline justify-between gap-3 border-b border-rule pb-3">
            <span class="font-display text-[1.375rem] leading-tight text-ink-900">
              {g.name}
              {g.renamed && (
                <span class="label ml-2 align-middle text-ink-300">{g.raw}</span>
              )}
            </span>
            <span class="label shrink-0 text-brass-600 tnum">{g.apps.length}</span>
          </dt>
          <dd class="mt-1">
            <ul class="divide-y divide-rule">
              {g.apps.map((a) => (
                <li class="flex items-baseline justify-between gap-4 py-2.5">
                  <span class="text-sm text-ink-900">
                    {a.label}
                    {a.renamed && (
                      <span class="ml-2 font-mono text-[0.6875rem] text-ink-300">{a.name}</span>
                    )}
                  </span>
                  <span class="label shrink-0 text-ink-300 tnum">{a.module}</span>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  )}

  {inclusions && !compact && (
    <div class="mt-14">
      <h3 class="label text-brass-600">Also included — platform, not a choice</h3>
      <p class="mt-3 max-w-prose text-ink-700">
        These are not tiles in the catalog and are not sold separately. Every
        tenant gets them, because they are part of the platform itself. Each one
        names the module it comes from.
      </p>
      <dl class="mt-px mt-6 grid gap-px bg-rule sm:grid-cols-2 lg:grid-cols-3">
        {PLATFORM_INCLUSIONS.map((p) => (
          <div class="rise-block bg-paper p-6">
            <dt class="text-[1.0625rem] text-ink-900">{p.title}</dt>
            <dd class="mt-2 text-sm text-ink-700">{p.body}</dd>
            <dd class="mt-3 font-mono text-[0.6875rem] text-ink-300">{p.source}</dd>
          </div>
        ))}
      </dl>
    </div>
  )}
</div>

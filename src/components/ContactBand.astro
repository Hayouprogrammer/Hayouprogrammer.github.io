---
interface Props {
  title?: string;
  body?: string;
  primaryLabel?: string;
  primaryHref?: string;
};

const {
  title = 'Start a conversation',
  body = 'Tell me what your hotel, portfolio or business is trying to run on. I will tell you honestly whether Imbirt is the right system for it — and what it would take.',
  primaryLabel = 'Email me',
  primaryHref = 'mailto:hayelomgebrewahid@gmail.com',
} = Astro.props;

import contact from '../data/contact.json';

const channels = contact.channels;
---

<section class="mt-24 bg-ledger-900 text-bone">
  <div class="dossier mx-auto w-full max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div>
        <p class="label text-brass-400">§ 06 — Contact</p>
        <h2 class="mt-3 text-[clamp(1.875rem,4.5vw,3rem)] text-bone">{title}</h2>
        <p class="mt-4 max-w-prose text-lg text-bone/75 text-pretty">{body}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href={primaryHref}
            class="label inline-flex items-center gap-2 bg-brass-400 px-5 py-3 text-ledger-900 no-underline transition-colors hover:bg-brass-200"
          >
            {primaryLabel}
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/cv"
            class="label inline-flex items-center gap-2 border border-rule-bone px-5 py-3 text-bone no-underline transition-colors hover:border-bone"
          >
            Print / save CV
          </a>
        </div>
      </div>

      <div>
        <table class="w-full border-collapse text-left text-sm">
          <caption class="label mb-3 text-left text-bone/60">Reach me directly</caption>
          <tbody>
            {channels.map((c) => (
              <tr class="border-b border-rule-bone">
                <th scope="row" class="py-3 pr-4 align-top font-normal text-bone/70">{c.label}</th>
                <td class="py-3 pr-4 align-top">
                  <a href={c.href} class="font-medium text-bone no-underline hover:underline">
                    {c.value}
                  </a>
                  <span class="label ml-2 hidden text-brass-400 sm:inline">{c.note}</span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="mt-4 text-sm text-bone/60">
          Based in Addis Ababa (GMT+3). I reply to Telegram and WhatsApp the same day.
        </p>
      </div>
    </div>
  </div>
</section>

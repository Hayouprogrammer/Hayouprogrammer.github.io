---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import FigurePlate from './FigurePlate.astro';

interface Props {
  /** File name under public/screens/, e.g. "tenant-ops-tenants.png" */
  file: string;
  plate: string;
  caption: string;
  measure?: string;
  alt: string;
  aspect?: string;
  priority?: boolean;
}

const { file, plate, caption, measure, alt, aspect, priority = false } = Astro.props;

const publicRoot = fileURLToPath(new URL('../../public', import.meta.url));
const captured = existsSync(`${publicRoot}/screens/${file}`);
const optimised = existsSync(`${publicRoot}/shots/${file.replace(/\.[^.]+$/, '.webp')}`);
const stem = `/shots/${file.replace(/\.[^.]+$/, '')}`;
---

{captured && optimised ? (
  <FigurePlate
    src={stem}
    plate={plate}
    caption={caption}
    measure={measure}
    alt={alt}
    aspect={aspect}
    priority={priority}
  />
) : (
  <figure>
    <div
      class="flex items-center justify-center border border-dashed border-rule-strong bg-paper-raised px-6 py-10 text-center"
      style={`aspect-ratio: ${aspect ?? '16 / 10'}`}
    >
      <div>
        <p class="label text-ink-500">{plate} — capture pending</p>
        <p class="mx-auto mt-2 max-w-[22ch] text-sm text-ink-500">{caption}</p>
      </div>
    </div>
    <figcaption class="mt-2.5 flex items-baseline justify-between gap-4">
      <span class="flex items-baseline gap-2.5">
        <span class="label text-brass-600 tnum">{plate}</span>
        <span class="text-sm text-ink-700">{caption}</span>
      </span>
      {measure && <span class="label hidden shrink-0 text-ink-300 tnum sm:inline">{measure}</span>}
    </figcaption>
  </figure>
)}

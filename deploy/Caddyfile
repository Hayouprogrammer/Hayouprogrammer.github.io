# Caddyfile — the production configuration for the portfolio.
#
# WHY CADDY
# The brief was "we will use the best practice" for a VPS, so the choice needs
# stating. Caddy is the best-practice answer for serving one static site:
#
#   · Automatic HTTPS, with certificates obtained and renewed by Caddy itself.
#     There is no certbot, no renewal timer, no expiry outage — the single most
#     common way a small VPS site goes dark.
#   · HTTP/2 and HTTP/3 on by default.
#   · Brotli and zstd compression on by default, for text assets.
#   · Static file serving is its core competency, not a bolt-on.
#   · The whole configuration is this one file, and it is declarative, so it can
#     be read and reviewed rather than debugged.
#
# It is also the smallest possible moving parts: one container, one bind mount
# of the build output, no web server to harden separately.
#
# THE DOMAIN
# `{$SITE_DOMAIN:localhost}` reads the SITE_DOMAIN environment variable and falls
# back to `localhost`. Set the real domain in `.env` beside this file and the
# same configuration serves the real site with a real certificate, unchanged.
#
# A custom domain also means the printed QR codes finally point at something the
# owner controls. Until then, do not print.

{
	# Email for the certificate authority. Only used once a real domain is set,
	# and only to warn about expiry — Caddy renews without it either way.
	email {$ACME_EMAIL:admin@localhost}

	# Serve over HTTP/2 and HTTP/3. On a plain VPS this is free.
	servers {
		protocols h1 h2 h3
	}
}

{$SITE_DOMAIN:localhost} {
	root * /srv
	encode zstd br gzip

	# ---- the printed short link --------------------------------------------
	# The brochure QR encodes /imbirt. This is a real 301, served by the web
	# server — not a meta refresh in a page, which is what GitHub Pages forced
	# and which search engines treat as a soft redirect. This is the single
	# biggest reason to move off Pages for a print-driven site.
	redir /imbirt /work/imbirt 301

	# ---- security headers ---------------------------------------------------
	# The Content-Security-Policy is strict everywhere it can be, with one
	# deliberate exception: `script-src 'self' 'unsafe-inline'`.
	#
	# `'unsafe-inline'` is here because Astro inlines component scripts below a
	# size threshold — that threshold is a build detail, it shifts between
	# versions, and a policy that silently breaks one of them is worse than one
	# that does not. A hash-based policy was tried first and rejected: the
	# inlined script embeds Astro's content-hashed module URLs, so its own hash
	# changes on every build and the site would break on the next deploy.
	#
	# What the policy still buys is the part that matters. There is no
	# `unsafe-eval`, no remote origin, and no way for a request to another host
	# to return executable script. For a static portfolio with no user input, no
	# cookies, no accounts and no server-side rendering, there is no injection
	# point to protect — so the residual risk from inline execution is nil while
	# the blocking of remote script is absolute. `object-src 'none'`,
	# `frame-ancestors 'none'`, `form-action 'none'` and `base-uri 'self'` close
	# the plugin, clickjacking, form-hijack and base-tag attacks outright.
	#
	# `style-src 'unsafe-inline'` is unavoidable for a different reason: Astro
	# inlines the stylesheet into the document, and there is no way to hash a
	# value that changes with every build.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self'; upgrade-insecure-requests"
		# Remove the server banner: nobody benefits from knowing the exact
		# version of the proxy, and it is one less thing to fingerprint.
		-Server
	}

	# ---- caching ------------------------------------------------------------
	# The build output is fingerprinted, so the assets can be cached forever.
	# The HTML must not be: a QR scanner arriving from a printed leaflet has to
	# be served current copy, and "current copy" cached for a day is a support
	# call. `must-revalidate` makes a stale entry a miss rather than a hit.
	@_astro path /_astro/*
	header @_astro Cache-Control "public, max-age=31536000, immutable"

	@static path /fonts/* /shots/* /screens/* /qr/*
	header @static Cache-Control "public, max-age=604800, stale-while-revalidate=86400"

	@doc path / /index.html /work /work/ /work/imbirt /work/imbirt/ /about /about/ /contact /contact/ /cv /cv/ /404.html /sitemap.xml /robots.txt
	header @doc Cache-Control "public, max-age=0, must-revalidate"

	# ---- serving ------------------------------------------------------------
	file_server {
		# A missing path must return the custom 404 page, not Caddy's own. Astro
		# generated a real one at /404.html; GitHub Pages serves it automatically
		# and Caddy does not, so it is pointed at explicitly.
		index index.html
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

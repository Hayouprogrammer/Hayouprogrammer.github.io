---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Shot from '../components/Shot.astro';
import RuleTable from '../components/RuleTable.astro';
import Stamp from '../components/Stamp.astro';
import ContactBand from '../components/ContactBand.astro';
import ScopeGrid from '../components/ScopeGrid.astro';
import ArchitectureSection from '../components/ArchitectureSection.astro';
import figures from '../data/figures.json';

const code = figures.code;
const tests = figures.tests;

const fmt = (n: number) => n.toLocaleString('en-US');


const principles = [
  {
    n: '01',
    title: 'Prove it, then claim it',
    body: 'Every number on this site is generated from the repository by a script. If a figure cannot be re-derived, it does not go on the page.',
  },
  {
    n: '02',
    title: 'Delete before you add',
    body: 'Imbirt shipped a 43-file custom access-control engine, then deleted it once native Odoo groups did the job better. Removing code is engineering too.',
  },
  {
    n: '03',
    title: 'Isolation is architecture, not a promise',
    body: 'One tenant, one PostgreSQL database, separated by least-privilege roles. Not a WHERE clause somebody has to remember to write.',
  },
  {
    n: '04',
    title: 'Safe by default, not by permission',
    body: 'The AI assistant never executes a write the user has not confirmed. Read tools never confirm; medium-risk and above always do.',
  },
];

const stack = [
  ['Platform', 'Odoo 19.0 Community (LGPL-3)', 'no per-user fee — add fifty staff and the bill does not move'],
  ['Language', 'Python 3.12', 'ORM, controllers, scheduled actions, security rules'],
  ['Database', 'PostgreSQL 16', 'one database per tenant, least-privilege roles'],
  ['Infrastructure', 'Docker Compose', 'dev profile + hardened production profile'],
  ['Tenancy', 'Host routing → database resolution', 'server-wide, fails closed on an unknown host'],
  ['AI', 'Cloud LLM, OpenAI-compatible', 'swappable provider, bring-your-own key'],
  ['CI', 'GitHub Actions', 'lint matrix + Odoo test matrix on PostgreSQL 16'],
  ['Frontend', 'OWL / JavaScript / SCSS', 'plus React and Android from earlier work'],
];
---

<Base
  title="Hayelom Gebrewahid — ERP & Platform Engineer, Addis Ababa"
  description="I designed and built Imbirt, a multi-tenant ERP on Odoo 19 for hospitality, property and trading businesses. Based in Addis Ababa."
  plate="PL. 01"
>
  <!-- ================= PLATE 01 — COVER ================= -->
  <section class="dossier mx-auto w-full max-w-6xl px-4 pt-14 pb-4 sm:px-6 sm:pt-20">
    <div class="flex flex-wrap items-center gap-3">
      <span class="label text-brass-600">Plate 01 — Dossier cover</span>
      <span class="h-3 w-px bg-rule-strong" aria-hidden="true"></span>
      <span class="label text-ink-500 tnum">{code.customTrees} custom addons · {code.lines.toLocaleString('en-US')} lines</span>
    </div>

    <div class="mt-8 grid items-start gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
      <div>
        <h1 class="kinetic text-[clamp(2.5rem,7vw,4.5rem)] leading-[0.95]">
          {['I', 'build', 'the', 'operational', 'software', 'businesses', 'actually', 'run', 'on.']
            .map((w, i) => (
              <span style={`animation-delay: ${80 + i * 65}ms`}>{w}&nbsp;</span>
            ))}
        </h1>

        <p class="mt-6 max-w-prose text-lg text-ink-700 text-pretty">
          My name is Hayelom Gebrewahid. I designed and built
          <strong class="font-medium text-ink-900">Imbirt</strong> — a complete back
          office on Odoo 19 covering people, money, stock, sales, projects,
          documents and the website, that arrives configured for hotels, landlords
          and trading companies. Every customer gets their own database, and the
          AI assistant cannot write anything to your books without asking you
          first.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/work/imbirt"
            class="label inline-flex items-center gap-2 bg-ledger-900 px-5 py-3.5 text-bone no-underline transition-colors hover:bg-ledger-700"
          >
            Read the Imbirt case study
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/contact"
            class="label inline-flex items-center gap-2 border border-rule-strong px-5 py-3.5 text-ink-900 no-underline transition-colors hover:border-ledger-700 hover:bg-paper-raised"
          >
            Start a conversation
          </a>
        </div>

        <div class="dim-rule mt-10" aria-hidden="true"></div>

        <dl class="mt-5 grid grid-cols-2 gap-x-8 gap-y-4 sm:grid-cols-4">
          {[
            ['Custom addons', fmt(code.customTrees)],
            ['Lines of code', fmt(code.lines)],
            ['Tests', fmt(tests.functions)],
            ['Runtime', 'Odoo 19'],
          ].map(([k, v]) => (
            <div>
              <dt class="label text-ink-500">{k}</dt>
              <dd class="mt-1 font-display text-2xl tnum">{v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- The first viewport is a thesis: show the artifact, not a portrait. -->
      <div class="lg:sticky lg:top-20">
        <Shot
          file="tenant-ops-tenants.png"
          plate="FIG. 01"
          caption="The control plane — every tenant, its package and its state on one screen."
          measure="1600 × 1000"
          alt="Imbirt Tenant Operations list showing the tenant registry with package and state columns"
          priority
        />
        <div class="mt-4 flex flex-wrap gap-2">
          <Stamp tone="ledger">No per-user licence</Stamp>
          <Stamp tone="brass">Cloud or your own server</Stamp>
          <Stamp tone="ink">Built on Odoo 19</Stamp>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= § 01 — THE PLATFORM ================= -->
  <section class="dossier rise mx-auto w-full max-w-6xl px-4 pt-24 sm:px-6">
    <SectionHead
      serial="§ 01"
      kicker="The platform"
      title="Three planes, and the boundaries between them are drawn in the architecture."
      lede="Imbirt is not a set of dashboards bolted onto Odoo. It is a control plane that provisions tenants, a data plane that isolates them, and an application plane that gives each industry the modules it actually needs."
    />

    <div class="mt-10 max-w-prose text-lg text-ink-700">
      <p>
        The tenant operator picks an industry — hospitality, property or business —
        and one action does the rest: a PostgreSQL database is created and its
        privileges are separated by role, the package's install profile runs, the
        owner is granted exactly the native Odoo groups that job needs, and the
        state flips to <em>Active</em>. If any step fails, the whole provision rolls
        back. Nothing is half-created.
      </p>
      <p class="mt-4">
        That design decision is the spine of the whole platform: nothing is shared
        between tenants except the code that provisions them.
      </p>
    </div>

    <ArchitectureSection />

    <div class="mt-8 grid gap-10 lg:grid-cols-[1.15fr_0.85fr]">
      <RuleTable
        caption="Table 1 — verified counts, generated from ethio-erp-addons by scripts/collect-figures.mjs"
        rows={[
          ['Custom addon trees', `${fmt(code.customTrees)}`, `${code.authoredTrees} Imbirt-authored (LGPL-3), 4 modified upstream (AGPL-3)`],
          ['Source files', fmt(code.files), 'Python, XML, JavaScript, SCSS, CSV'],
          ['Lines of code', fmt(code.lines), 'custom trees only — vendored upstream excluded'],
          ['Test files', fmt(tests.files), 'Odoo test suites, run in CI'],
          ['Test functions', fmt(tests.functions), 'unit + integration coverage'],
          ['Addon trees on the path', fmt(figures.repo.addonTrees), 'Imbirt custom + curated OCA and third-party'],
        ]}
      />

      <div class="border border-rule bg-paper-raised p-6">
        <p class="label text-ink-500">Largest modules</p>
        <ol class="mt-4 space-y-3">
          {figures.modules.slice(0, 6).map((m) => (
            <li class="flex items-baseline justify-between gap-4 border-b border-rule pb-2.5 last:border-0">
              <span class="font-mono text-sm text-ink-900">{m.module}</span>
              <span class="label text-ink-500 tnum">{fmt(m.lines)}</span>
            </li>
          ))}
        </ol>
        <p class="mt-4 text-xs text-ink-500">
          Lines across Python, XML, JavaScript and SCSS.
        </p>
      </div>
    </div>
  </section>

  <!-- ================= § 02 — WHAT IT RUNS ================= -->
  <section class="dossier rise mx-auto w-full max-w-6xl px-4 pt-24 sm:px-6">
    <SectionHead
      serial="§ 02"
      kicker="The work"
      title="What it runs."
      lede="Not three industries and a website. A whole back office, with two verticals deep enough to run a hotel and a rent roll."
    />

    <div class="mt-10">
      <ScopeGrid />
    </div>

    <div class="mt-8 grid gap-px border border-rule bg-rule sm:grid-cols-2">
      <a href="/work" class="group bg-paper p-7 no-underline transition-colors hover:bg-paper-raised">
        <span class="label text-brass-600 tnum">PL. 02</span>
        <h3 class="mt-3 text-xl text-ink-900 group-hover:underline">
          Find the part that describes your business
        </h3>
        <p class="mt-2.5 text-ink-700">
          Pick the sentence that fits — hotel, property, trading, or the whole
          back office — and see the screen you would work in and the modules you
          would get.
        </p>
        <span class="label mt-5 inline-block text-ink-500 transition-colors group-hover:text-brass-600">
          Open the index <span aria-hidden="true">→</span>
        </span>
      </a>

      <a href="/work/imbirt" class="group bg-paper p-7 no-underline transition-colors hover:bg-paper-raised">
        <span class="label text-brass-600 tnum">CS. 01</span>
        <h3 class="mt-3 text-xl text-ink-900 group-hover:underline">
          The Imbirt case study
        </h3>
        <p class="mt-2.5 text-ink-700">
          How the platform is put together: the control plane, the isolated data
          plane, the governed AI assistant, and what it takes to provision a
          whole business in one action.
        </p>
        <span class="label mt-5 inline-block text-ink-500 transition-colors group-hover:text-brass-600">
          Read it <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </section>

  <!-- ================= § 03 — HOW I WORK ================= -->
  <section class="dossier rise mx-auto w-full max-w-6xl px-4 pt-24 sm:px-6">
    <SectionHead
      serial="§ 03"
      kicker="Position"
      title="Four things I insist on, even when they cost me time."
      lede="These are not slogans. Each one is a decision visible in the repository history."
    />

    <div class="mt-10 grid gap-px border border-rule bg-rule sm:grid-cols-2">
      {principles.map((p) => (
        <div class="bg-paper p-7">
          <span class="label text-brass-600 tnum">{p.n}</span>
          <h3 class="mt-3 text-xl">{p.title}</h3>
          <p class="mt-2.5 text-ink-700">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ================= § 04 — STACK ================= -->
  <section class="dossier rise mx-auto w-full max-w-6xl px-4 pt-24 sm:px-6">
    <SectionHead serial="§ 04" kicker="Stack" title="What I build with." />

    <div class="mt-8 max-w-3xl">
      <RuleTable
        caption="Table 2 — the platform I run Imbirt on"
        rows={stack}
      />
    </div>
  </section>

  <ContactBand />
</Base>
